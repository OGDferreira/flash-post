ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-secret
