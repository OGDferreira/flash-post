{
  "name": "flashpost-video",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "narrate": "python3 audio/narrate.py",
    "music": "python3 audio/synth.py src/timeline.json out/audio",
    "render": "remotion render src/index.ts FlashPost out/video-silent.mp4 --muted --codec=h264 --crf=18",
    "mix": "python3 audio/mix.py out/video-silent.mp4 out/flashpost-reels.mp4",
    "build": "npm run narrate && npm run music && npm run render && npm run mix"
  },
